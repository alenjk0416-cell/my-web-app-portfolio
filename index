                    resolve({ 
                        current: MockGenerator.current, 
                        lastMonthData: MockGenerator.last, 
                        historical: MockGenerator.historical,
                        sheetName: month || new Date().toISOString().slice(0, 10)
                    });
                }, 1500); 
            }),
            getSheetNames: () => new Promise((resolve) => {
                setTimeout(() => resolve(["2025-02-20", "2025-01-20", "2024-12-20"]), 300);
            })
        };

        // --- Core Application Logic ---

        async function fetchData(isRetry = false) {
            if (!isRetry) setState({ isLoading: true, error: null });
            
            try {
                const data = await api.getSheetData(stateStore.filters.selectedMonth);
                
                // Remove Intro Screen
                if (dom['intro-screen']) {
                    dom['intro-screen'].classList.add('fade-out');
                    setTimeout(() => { IntroNetwork.stop(); }, 1200);
                }

                if (dom.submissionDate) dom.submissionDate.textContent = data.sheetName ? data.sheetName.replace(/-/g, '/') : 'N/A';
                _updateColorMap(data.current || []);
                setState({
                    allData: data.current || [],
                    historicalData: data.historical || { labels: [], values: [] },
                    lastMonthData: data.lastMonthData || [],
                    isLoading: false,
                    error: null
                });
                applyFiltersAndRender();
            } catch (error) {
                console.error("Data fetch failed:", error);
                setState({ isLoading: false, error: utils.t('errorDataLoad') });
                if (dom['intro-screen']) dom['intro-screen'].classList.add('fade-out');
                render();
            }
        }

        function setState(partial) {
            Object.keys(partial).forEach(k => {
                const newVal = partial[k];
                const curVal = stateStore[k];
                if (curVal && typeof curVal === 'object' && !Array.isArray(curVal) && newVal && typeof newVal === 'object' && !Array.isArray(newVal)) {
                    stateStore[k] = { ...curVal, ...newVal };
                } else {
                    stateStore[k] = newVal;
                }
            });
        }

        const utils = {
            t: (key, ...args) => {
                const resource = i18nResources[stateStore.uiLang] || i18nResources.ja;
                const value = key.split('.').reduce((o, k) => (o || {})[k], resource);
                if (typeof value === 'function') return value(...args);
                return value || (key === 'unclassified' ? '未分類' : key);
            },
            debounce: (func, delay = 300) => {
                let timeoutId;
                return (...args) => {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => func(...args), delay);
                };
            },
            htmlToElement: (html) => {
                const template = document.createElement('template');
                template.innerHTML = html.trim();
                return template.content;
            },
            escapeHtml: (str) => String(str || '').replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' })[m]),
            formatNumber: (num) => new Intl.NumberFormat((stateStore.uiLang || 'ja').replace('_', '-')).format(num),
            saveState: () => localStorage.setItem('dashboardState_portfolio', JSON.stringify({ uiLang: stateStore.uiLang, thresholds: stateStore.thresholds })),
            loadState: () => {
                const saved = JSON.parse(localStorage.getItem('dashboardState_portfolio') || '{}');
                if (saved.uiLang) setState({ uiLang: saved.uiLang });
                if (saved.thresholds) setState({ thresholds: saved.thresholds });
            },
            getTrend: (current, last) => {
                if (last > 0) {
                    const percentage = Number((((current - last) / last) * 100).toFixed(1));
                    const text = current > last ? utils.t('trendIncrease') : (current < last ? utils.t('trendDecrease') : utils.t('trendNoChange'));
                    const color = current > last ? 'text-red-500' : (current < last ? 'text-green-500' : 'text-slate-400');
                    return { percentage, text, color, change: current - last };
                }
                return { percentage: 0.0, text: utils.t('trendNoChange'), color: 'text-slate-400', change: 0 };
            },
            getSortComparator: (sortKey) => {
                const K = CONFIG.KEYS;
                return (a, b) => {
                    if (sortKey === 'quantity_asc') return (Number(a[K.QUANTITY]) || 0) - (Number(b[K.QUANTITY]) || 0);
                    if (sortKey === 'quantity_desc') return (Number(b[K.QUANTITY]) || 0) - (Number(a[K.QUANTITY]) || 0);
                    return 0;
                };
            }
        };

        function populateLocationFilterFromData(baseData) {
            if (!dom.locationFilter) return; 
            const K = CONFIG.KEYS;
            const locations = [...new Set(baseData.map(item => item[K.LOCATION] || utils.t('unclassified')))].sort();
            dom.locationFilter.innerHTML = `<option value="all">${utils.t('allLocations')}</option>` + 
                locations.map(loc => `<option value="${loc}">${loc}</option>`).join('');
            dom.locationFilter.value = stateStore.filters.selectedLocation;
        }

        function applyFiltersAndRender() {
            const { searchQuery, selectedLocation, selectedDept } = stateStore.filters;
            const query = (searchQuery || '').toLowerCase().trim();
            const K = CONFIG.KEYS;
            const unclassifiedLabel = utils.t('unclassified');

            let filteredCurrent = stateStore.allData.slice();
            if (selectedDept) filteredCurrent = filteredCurrent.filter(item => (item[K.DEPT] || unclassifiedLabel) === selectedDept);
            if (query) {
                filteredCurrent = filteredCurrent.filter(item =>
                    (item[K.NAME] || '').toLowerCase().includes(query) ||
                    (item[K.DEPT] || unclassifiedLabel).toLowerCase().includes(query) ||
                    (item[K.LOCATION] || unclassifiedLabel).toLowerCase().includes(query)
                );
            }
            populateLocationFilterFromData(filteredCurrent); 

            if (selectedLocation !== 'all') {
                filteredCurrent = filteredCurrent.filter(item => (item[K.LOCATION] || unclassifiedLabel) === selectedLocation);
            }

            // Grouping logic
            const groupedByLocation = filteredCurrent.reduce((acc, item) => {
                const location = item[K.LOCATION] || unclassifiedLabel;
                if (!acc[location]) acc[location] = { items: [], total: 0 };
                acc[location].items.push(item);
                acc[location].total += (Number(item[K.QUANTITY]) || 0);
                return acc;
            }, {});

            const sortedLocations = Object.keys(groupedByLocation).sort();

            setState({
                groupedByLocation,
                filteredData: sortedLocations,
                currentFilteredData: filteredCurrent, 
                currentFilteredLastMonthData: stateStore.lastMonthData, // Simplified for portfolio
                pagination: { ...stateStore.pagination, totalItems: sortedLocations.length, currentPage: 1 }
            });

            updateDataView();
            render();
        }

        function _updateColorMap(data) {
            const K = CONFIG.KEYS;
            const departments = [...new Set(data.map(item => item[K.DEPT] || utils.t('unclassified')))];
            const newColorMap = { ...stateStore.departmentColorMap };
            departments.forEach((dept, i) => {
                if (!newColorMap[dept]) newColorMap[dept] = COLOR_PALETTE[i % COLOR_PALETTE.length];
            });
            setState({ departmentColorMap: newColorMap });
        }

        function updateDataView() {
            const { currentPage, itemsPerPage } = stateStore.pagination;
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            if (currentPage === 1) {
                setState({ currentLocationView: stateStore.filteredData.slice(0, itemsPerPage) });
            } else {
                setState({ currentLocationView: [...stateStore.currentLocationView, ...stateStore.filteredData.slice(start, end) ]});
            }
        }

        function render() {
            if (stateStore.isLoading) return;
            renderUIStrings();
            renderSummary();
            renderKPIs();
            renderWarning();
            renderCards();
        }

        function renderUIStrings() {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const text = utils.t(el.dataset.i18n);
                if (text && el.textContent !== text) el.textContent = text;
            });
        }

        function renderWarning() {
            const K = CONFIG.KEYS;
            const threshold = stateStore.thresholds.warning;
            const warningItems = (stateStore.currentFilteredData || stateStore.allData).filter(item => Number(item[K.QUANTITY]) > threshold);

            if (!dom.warningContainer) return;
            if (warningItems.length === 0) { dom.warningContainer.style.display = 'none'; return; }
            dom.warningContainer.style.display = 'flex'; 

            dom.warningTableHeader.innerHTML = ['name', 'department', 'quantity'].map(h => 
                `<th class="py-1.5 px-3 text-left whitespace-nowrap bg-red-50 text-xs font-semibold text-red-900 sticky top-0 z-10 border-b border-red-100 ${h==='quantity'?'text-right pr-6':''}">${utils.t(`columnHeaders.${h}`)}</th>`
            ).join('');

            dom.warningTableBody.innerHTML = warningItems.sort((a,b) => Number(b[K.QUANTITY]) - Number(a[K.QUANTITY])).map(item => `
                <tr class="hover:bg-red-50 transition-colors border-b border-red-50 last:border-0">
                    <td class="py-1 px-3 text-slate-700 font-medium truncate max-w-[100px]">${item[K.NAME]}</td>
                    <td class="py-1 px-3 text-slate-500 text-xs truncate max-w-[80px]">${item[K.DEPT]}</td>
                    <td class="py-1 pl-3 pr-6 text-right tabular-nums text-red-600 font-bold text-sm whitespace-nowrap">${utils.formatNumber(item[K.QUANTITY])}</td>
                </tr>`).join('');
        }

        function renderSummary() {
            if (!dom.summaryList) return;
            const K = CONFIG.KEYS;
            const dataSource = stateStore.currentFilteredData || stateStore.allData;
            const totalQuantity = dataSource.reduce((s, item) => s + (Number(item[K.QUANTITY]) || 0), 0);
            const lastMonthTotal = stateStore.lastMonthData.reduce((s, item) => s + (Number(item[K.QUANTITY]) || 0), 0);
            const trend = utils.getTrend(totalQuantity, lastMonthTotal);
            
            const locations = [...new Set(dataSource.map(item => item[K.LOCATION]))];
            const topLocation = Object.entries(dataSource.reduce((acc, item) => {
                const loc = item[K.LOCATION]; acc[loc] = (acc[loc] || 0) + (Number(item[K.QUANTITY]) || 0); return acc;
            }, {})).sort((a,b)=>b[1]-a[1])[0]?.[0] || 'N/A';
            const topDept = Object.entries(dataSource.reduce((acc,item)=>{
                const dept = item[K.DEPT]; acc[dept] = (acc[dept] || 0) + (Number(item[K.QUANTITY]) || 0); return acc;
            }, {})).sort((a,b)=>b[1]-a[1])[0]?.[0] || 'N/A';

            dom.summaryList.innerHTML = `
                <li class="flex items-start gap-3 animate-fade-in"><div class="mt-0.5"><i class="ph-fill ph-trend-up text-blue-500"></i></div><span>${utils.t('summaryTotal', utils.formatNumber(totalQuantity))} ${trend.percentage !== 0 ? utils.t('summaryTrend', trend, trend.text) : ''}</span></li>
                <li class="flex items-start gap-3 animate-fade-in" style="animation-delay: 0.1s;"><div class="mt-0.5"><i class="ph-fill ph-map-pin text-orange-500"></i></div><span>${utils.t('summaryLocations', locations.length, utils.escapeHtml(topLocation))}</span></li>
                <li class="flex items-start gap-3 animate-fade-in" style="animation-delay: 0.2s;"><div class="mt-0.5"><i class="ph-fill ph-users text-emerald-500"></i></div><span>${utils.t('summaryDepts', utils.escapeHtml(topDept))}</span></li>
            `;
        }

        function renderKPIs() {
            if (!dom.kpiGrid) return;
            const K = CONFIG.KEYS;
            const dataSource = stateStore.currentFilteredData || stateStore.allData;
            const totalQuantity = dataSource.reduce((sum, item) => sum + (Number(item[K.QUANTITY]) || 0), 0);
            const lastMonthTotal = stateStore.lastMonthData.reduce((sum, item) => sum + (Number(item[K.QUANTITY]) || 0), 0);
            const trend = utils.getTrend(totalQuantity, lastMonthTotal);
            const locationCount = [...new Set(dataSource.map(item => item[K.LOCATION]))].length;
            const departmentCount = [...new Set(dataSource.map(item => item[K.DEPT]))].length;

            const kpis = [
                { label: utils.t('kpiTotalQuantity'), value: utils.formatNumber(totalQuantity) },
                { label: utils.t('kpiTrend'), value: `${Math.abs(trend.percentage)}%`, subtext: `(${trend.change > 0 ? '+' : ''}${trend.change})`, color: trend.color },
                { label: utils.t('kpiLocations'), value: locationCount },
                { label: utils.t('kpiDepartments'), value: departmentCount }
            ];
            
            dom.kpiGrid.innerHTML = kpis.map((kpi, index) => `
                <div class="bg-white/90 backdrop-blur p-4 rounded-xl border border-slate-100 shadow-sm flex flex-col items-start hover:shadow-md transition-all animate-fade-in" style="animation-delay: ${index * 0.1}s;">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">${kpi.label}</p>
                    <div class="flex items-end gap-2 w-full">
                        <p class="text-2xl font-bold text-slate-800 leading-none tabular-nums ${kpi.color || ''}">${kpi.value}</p>
                        ${kpi.subtext ? `<p class="text-[10px] font-semibold ${kpi.color || 'text-slate-400'} mb-0.5 tabular-nums">${kpi.subtext}</p>` : ''}
                    </div>
                </div>`).join('');
        }

        function renderCards() {
            const container = dom.dataCardsContainer;
            if (!container) return;
            if (stateStore.pagination.currentPage === 1) container.innerHTML = '';
            
            const locationsToRender = stateStore.currentLocationView;
            if (locationsToRender.length === 0 && stateStore.pagination.currentPage === 1) {
                container.innerHTML = `<div class="col-span-full text-center py-12 bg-white rounded-xl border border-dashed border-slate-200 text-slate-400 animate-fade-in"><i class="ph-duotone ph-magnifying-glass text-4xl mb-2"></i><p class="text-sm">${utils.t('noData')}</p></div>`;
                dom.loadMoreBtn.classList.add('hidden');
                return;
            }

            const fragment = document.createDocumentFragment();
            const startIdx = (stateStore.pagination.currentPage - 1) * stateStore.pagination.itemsPerPage;
            const newLocations = stateStore.currentLocationView.slice(startIdx);

            newLocations.forEach((location, index) => {
                const group = stateStore.groupedByLocation[location];
                if (!group) return;
                
                // Group Card Logic
                const itemsByDept = group.items.reduce((acc, item) => {
                    const dept = item[CONFIG.KEYS.DEPT] || utils.t('unclassified');
                    if (!acc[dept]) acc[dept] = []; acc[dept].push(item); return acc;
                }, {});

                const deptHtml = Object.keys(itemsByDept).sort().map(dept => {
                    const deptItems = itemsByDept[dept];
                    const deptTotal = deptItems.reduce((s, it) => s + (Number(it[CONFIG.KEYS.QUANTITY]) || 0), 0);
                    
                    const rows = deptItems.sort(utils.getSortComparator(stateStore.filters.sortKey)).map(item => {
                         const qty = Number(item[CONFIG.KEYS.QUANTITY]) || 0;
                         return `
                         <tr class="group/row hover:bg-slate-50 transition-colors border-b border-slate-100 last:border-0">
                            <td class="py-2.5 px-4 text-sm text-slate-700 font-medium truncate max-w-[150px]">${utils.escapeHtml(item[CONFIG.KEYS.NAME])}</td>
                            <td class="py-2.5 px-4 text-right"><span class="text-sm font-bold tabular-nums ${qty > stateStore.thresholds.warning ? 'text-red-600' : 'text-slate-800'}">${utils.formatNumber(qty)}</span></td>
                         </tr>`;
                    }).join('');

                    return `
                    <div class="bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm mb-4 last:mb-0">
                        <div class="bg-slate-50/80 px-3 py-2 flex justify-between items-center border-b border-slate-100">
                            <span class="font-bold text-xs text-slate-600 uppercase tracking-wide">${utils.escapeHtml(dept)}</span>
                            <span class="font-bold text-xs text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded shadow-sm tabular-nums">${utils.formatNumber(deptTotal)}</span>
                        </div>
                        <table class="w-full text-left"><tbody>${rows}</tbody></table>
                    </div>`;
                }).join('');

                const cardHtml = `
                    <details class="group bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden open:ring-2 open:ring-slate-100 animate-fade-in" style="animation-delay: ${index * 0.1}s">
                        <summary class="p-4 border-b border-slate-100 flex justify-between items-center cursor-pointer select-none bg-white">
                            <div class="flex items-center gap-3 overflow-hidden">
                                <div class="w-6 h-6 rounded bg-slate-100 flex items-center justify-center text-slate-400 group-open:bg-slate-800 group-open:text-white transition-colors shrink-0"><i class="ph-bold ph-caret-right text-xs group-open:rotate-90"></i></div>
                                <h3 class="font-bold text-sm text-slate-800 truncate">${utils.escapeHtml(location)}</h3>
                            </div>
                            <div class="shrink-0 text-right ml-4">
                                <span class="block text-lg font-bold text-slate-900 tabular-nums leading-none">${utils.formatNumber(group.total)}</span>
                                <span class="block text-[10px] font-medium text-slate-400 uppercase mt-1">Total</span>
                            </div>
                        </summary>
                        <div class="p-4 bg-slate-50 space-y-4 border-t border-slate-100">${deptHtml}</div>
                    </details>`;
                
                fragment.appendChild(utils.htmlToElement(cardHtml).firstElementChild);
            });
            
            container.appendChild(fragment);
            if (stateStore.currentLocationView.length < stateStore.filteredData.length) dom.loadMoreBtn.classList.remove('hidden');
            else dom.loadMoreBtn.classList.add('hidden');
        }

        // --- Chart Logic ---

        function setupChartObservers() {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const canvas = entry.target;
                        if (canvas.id === 'departmentChart') renderDepartmentChart();
                        else if (canvas.id === 'comparisonChart') renderComparisonChart();
                        obs.unobserve(canvas);
                    }
                });
            }, { rootMargin: '50px' });
            document.querySelectorAll('.lazy-chart').forEach(chart => observer.observe(chart));
        }

        function renderDepartmentChart() {
            if (!dom.departmentChart) return;
            const K = CONFIG.KEYS;
            dom.deptChartTitle.innerHTML = stateStore.chartState.isDrilledDown 
                ? `<button class="mr-2 hover:text-primary transition-colors" onclick="DashboardApp.handleDeptChartBack()"><i class="ph-bold ph-arrow-left"></i></button> 「${stateStore.chartState.drillDownDept}」 ${utils.t('individual')}` 
                : `<i class="ph-duotone ph-chart-pie-slice text-slate-400 mr-2"></i> ${utils.t('deptChartTitle')}`;

            let dataForChart;
            if (stateStore.chartState.isDrilledDown) {
                const deptName = stateStore.chartState.drillDownDept;
                dataForChart = stateStore.allData
                    .filter(it => (it[K.DEPT] || utils.t('unclassified')) === deptName)
                    .reduce((acc,curr) => { acc[curr[K.NAME]] = (acc[curr[K.NAME]] || 0) + (Number(curr[K.QUANTITY])||0); return acc; }, {});
            } else {
                dataForChart = stateStore.allData.reduce((acc,curr) => {
                    const dept = curr[K.DEPT] || utils.t('unclassified');
                    acc[dept] = (acc[dept] || 0) + (Number(curr[K.QUANTITY])||0); return acc;
                }, {});
            }

            const entries = Object.entries(dataForChart).sort((a,b) => b[1] - a[1]);
            const labels = entries.map(e=>e[0]);
            const values = entries.map(e=>e[1]);
            const backgroundColors = labels.map((l, idx) => stateStore.departmentColorMap[l] || COLOR_PALETTE[idx % COLOR_PALETTE.length]);

            if (departmentChartInstance) departmentChartInstance.destroy();
            
            departmentChartInstance = new Chart(dom.departmentChart.getContext('2d'), {
                type: 'bar',
                data: { labels, datasets: [{ label: utils.t('kpiTotalQuantity'), data: values, backgroundColor: backgroundColors, borderRadius: 4, borderSkipped: false, maxBarThickness: 40 }] },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    onClick: (evt, elements) => {
                        if (stateStore.chartState.isDrilledDown) { if (elements.length === 0) handleDeptChartBack(); } 
                        else if (elements.length > 0) {
                             handleDeptChartClick(departmentChartInstance.data.labels[elements[0].index]);
                        }
                    },
                    plugins: { legend: { display: false }, datalabels: { anchor: 'end', align: 'top', color: '#64748B', font: { weight: 'bold', size: 11 }, formatter: val => utils.formatNumber(val) } },
                    scales: { y: { beginAtZero: true, grace: '10%', border: { display: false }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false }, border: { display: false } } }
                }
            });
        }

        function renderComparisonChart() {
            if (!dom.comparisonChart) return;
            if (comparisonChartInstance) comparisonChartInstance.destroy();

            const labels = stateStore.historicalData.labels;
            const values = stateStore.historicalData.values;
            
            comparisonChartInstance = new Chart(dom.comparisonChart.getContext('2d'), {
                type: 'bar',
                data: { labels, datasets: [
                    { label: utils.t('kpiTotalQuantity'), data: values, backgroundColor: [utils.escapeHtml('#cbd5e1'), '#cbd5e1', '#cbd5e1', '#cbd5e1', '#0F172A'], borderRadius: 4, barPercentage: 0.6 },
                    { type: 'line', label: 'Trend', data: values, borderColor: '#EA580C', borderWidth: 2, tension: 0.3, pointBackgroundColor: '#fff', pointBorderColor: '#EA580C', pointBorderWidth: 2, pointRadius: 4, fill: false, datalabels: { display: false } }
                ]},
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, grace: '10%', grid: { color: '#f1f5f9' }, border: { display: false }}, x: { grid: { display: false }, border: { display: false }}},
                    plugins: { legend: { display: false }, datalabels: { anchor: 'end', align: 'top', color: '#64748B', font: { weight: 'bold', size: 11 }, formatter: val => utils.formatNumber(val) } }
                }
            });
        }

        // --- Event Handlers ---

        function handleDeptChartClick(label) {
            setState({ chartState: { isDrilledDown: true, drillDownDept: label }, filters: { ...stateStore.filters, searchQuery: '', selectedDept: label, selectedLocation: 'all' }});
            updateUIForChartInteraction();
        }

        function handleDeptChartBack() {
            setState({ chartState: { isDrilledDown: false, drillDownDept: null }, filters: { ...stateStore.filters, searchQuery: '', selectedDept: null, selectedLocation: 'all' }});
            updateUIForChartInteraction();
        }

        function updateUIForChartInteraction() {
            dom.searchFilter.value = '';
            dom.locationFilter.value = 'all';
            applyFiltersAndRender();
            renderDepartmentChart();
            renderComparisonChart();
        }

        function bindEvents() {
            if (dom.reloadButton) dom.reloadButton.addEventListener('click', () => { window.location.reload(); });
            if (dom.exportCsvButton) dom.exportCsvButton.addEventListener('click', () => { alert("Portfolio Demo: CSV Export triggered."); });
            if (dom.locationFilter) dom.locationFilter.addEventListener('change', (e) => { 
                setState({ filters: { ...stateStore.filters, selectedLocation: e.target.value }}); applyFiltersAndRender(); 
            });
            if (dom.monthFilter) dom.monthFilter.addEventListener('change', (e) => {
                 setState({ filters: { ...stateStore.filters, selectedMonth: e.target.value }}); fetchData(); 
            });
            if (dom.searchFilter) dom.searchFilter.addEventListener('input', utils.debounce((e) => {
                setState({ filters: { ...stateStore.filters, searchQuery: e.target.value }}); applyFiltersAndRender();
            }, 300));
            if (dom.warningThreshold) dom.warningThreshold.addEventListener('change', (e) => {
                setState({ thresholds: { warning: parseInt(e.target.value, 10) }}); renderWarning(); renderCards();
            });
            if (dom.langSwitcher) dom.langSwitcher.addEventListener('change', (e) => {
                setState({ uiLang: e.target.value }); populateFilters(); applyFiltersAndRender(); renderDepartmentChart();
            });
            if (dom.loadMoreBtn) dom.loadMoreBtn.addEventListener('click', () => {
                setState({ pagination: { ...stateStore.pagination, currentPage: stateStore.pagination.currentPage + 1 }}); updateDataView(); renderCards();
            });
        }

        async function populateFilters() {
            const sheetNames = await api.getSheetNames();
            dom.monthFilter.innerHTML = `<option value="">${utils.t('latestData')}</option>` + 
                sheetNames.map(name => `<option value="${name}">${name} Data</option>`).join('');
            dom.monthFilter.value = stateStore.filters.selectedMonth || '';
        }

        async function init() {
            cacheDom();
            utils.loadState();
            dom.langSwitcher.value = stateStore.uiLang;
            dom.warningThreshold.value = stateStore.thresholds.warning;
            bindEvents();
            await fetchData();
            await populateFilters();
            setupChartObservers();
        }

        return { init, handleDeptChartBack };
    })();

    document.addEventListener('DOMContentLoaded', () => DashboardApp.init());
